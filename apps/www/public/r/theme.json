{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Theme",
  "description": "The Calmponent look: full monochrome, pure neutral grays, color only for status, and an 8px radius. Replaces your theme colors.",
  "registryDependencies": [
    "isthatpratik/calmponent/tokens"
  ],
  "cssVars": {
    "theme": {
      "radius": "0.5rem"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#171717",
      "card": "#ffffff",
      "card-foreground": "#171717",
      "popover": "#ffffff",
      "popover-foreground": "#171717",
      "primary": "#171717",
      "primary-foreground": "#fafafa",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#171717",
      "muted": "#f5f5f5",
      "muted-foreground": "#666666",
      "accent": "#f5f5f5",
      "accent-foreground": "#171717",
      "border": "#e5e5e5",
      "input": "#858585",
      "ring": "#737373",
      "destructive": "#cb2a2f",
      "success": "#297a3a",
      "warning": "#a35200",
      "chart-1": "#171717",
      "chart-2": "#404040",
      "chart-3": "#737373",
      "chart-4": "#a3a3a3",
      "chart-5": "#d4d4d4",
      "sidebar": "#fafafa",
      "sidebar-foreground": "#171717",
      "sidebar-primary": "#171717",
      "sidebar-primary-foreground": "#fafafa",
      "sidebar-accent": "#f5f5f5",
      "sidebar-accent-foreground": "#171717",
      "sidebar-border": "#e5e5e5",
      "sidebar-ring": "#737373"
