    "dark": {
      "background": "#000000",
      "foreground": "#ededed",
      "card": "#181818",
      "card-foreground": "#ededed",
      "popover": "#1f1f1f",
      "popover-foreground": "#ededed",
      "primary": "#ededed",
      "primary-foreground": "#0a0a0a",
      "secondary": "#272727",
      "secondary-foreground": "#ededed",
      "muted": "#1f1f1f",
      "muted-foreground": "#a3a3a3",
      "accent": "#272727",
      "accent-foreground": "#ededed",
      "border": "#272727",
      "input": "#6b6b6b",
      "ring": "#737373",
      "destructive": "#ff6166",
      "success": "#62c073",
      "warning": "#f2a20d",
      "chart-1": "#ededed",
      "chart-2": "#d4d4d4",
      "chart-3": "#a3a3a3",
      "chart-4": "#737373",
      "chart-5": "#525252",
      "sidebar": "#000000",
      "sidebar-foreground": "#ededed",
      "sidebar-primary": "#ededed",
      "sidebar-primary-foreground": "#0a0a0a",
      "sidebar-accent": "#1f1f1f",
      "sidebar-accent-foreground": "#ededed",
      "sidebar-border": "#272727",
      "sidebar-ring": "#737373"
