{
  "name": "calmponent",
  "private": true,
  "description": "An open-source React UI library for shadcn/ui and Tailwind CSS, with every state built in.",
  "license": "MIT",
  "author": "Pratik Desai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isthatpratik/calmponent.git"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "registry:build": "node scripts/sync-tokens.mjs && shadcn build ./registry.json --output ./apps/www/public/r",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "shadcn": "^4.23.0",
    "turbo": "2.11.10"
  },
  "keywords": [
    "react",
    "ui-library",
    "component-library",
    "shadcn-ui",
    "tailwindcss",
    "base-ui",
    "accessibility"
  ]
}
